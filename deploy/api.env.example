# /etc/nongjiale/api.env
# 权限：chmod 600 /etc/nongjiale/api.env，属主 root
# 说明：systemd EnvironmentFile 格式，不是 shell 脚本；等号两边不要加空格，值不要加行内注释。

# ── 运行环境 ──────────────────────────────────────────────
# 必须为 mysql。漏了会用 application.yml 的默认 profile=local，起内存 H2，重启丢数据。
SPRING_PROFILES_ACTIVE=mysql

# ── MySQL ────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=njl
MYSQL_USER=njl
MYSQL_PASSWORD=CHANGE_ME_MYSQL

# ── Redis（只做缓存；口令漏配会持续刷 NOAUTH）────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME_REDIS

# ── CORS ─────────────────────────────────────────────────
# 逗号分隔，必须与前端实际访问地址一致（含协议和端口，结尾不要带 /）。
# 下面故意留成 CHANGE_ME，避免照抄 localhost 上线导致前端跨域。
# 示例：
#   同域子路径：https://example.com
#   三子域名：  https://www.example.com,https://admin.example.com,https://merchant.example.com
#   沿用端口：  http://1.2.3.4:43123,http://1.2.3.4:43124,http://1.2.3.4:43125
APP_CORS_ALLOWED_ORIGINS=http://CHANGE_ME_PUBLIC_IP:43123,http://CHANGE_ME_PUBLIC_IP:43124,http://CHANGE_ME_PUBLIC_IP:43125

# ── 在线接口文档 ─────────────────────────────────────────
# 生产保持 false。临时排查改 true，用完立刻关。
OPENAPI_ENABLED=false

# ── 微信小程序 ────────────────────────────────────────────
# 为空时微信相关接口返回 503「微信登录未配置」，进程仍可正常启动。
# Secret 只放这里，不要提交到仓库。
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_SECRET=
